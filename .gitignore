# Your own feed config - sources.example.ini is the template.
# Anchored to the repo root on purpose: an unanchored "sources.ini" would also
# swallow sample/sources.ini, which the bundled demo build needs.
/sources.ini
# Your switch list (real addresses) - network.example.ini is the template.
/network.ini
# The encrypted SNMPv3 credential belongs in the output folder only, never here.
network-credential.bin*


# Built output
console-site/
*.pyc
__pycache__/

# Runtime logs the scripts write beside themselves
setup.log
check-setup.log
